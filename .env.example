# docker compose up needs none of this. Copy to .env only to change a default. Never commit .env.
#
# ANTHROPIC_API_KEY=            # With a key set, LLM_PROVIDER=auto uses the hosted LLM instead of the template script.
# LLM_PROVIDER=auto             # auto | anthropic | heuristic
# LLM_MODEL=claude-opus-5-5
# LLM_JUDGE_MODEL=              # Optional different model for the judge. Defaults to LLM_MODEL.
# LLM_EFFORT=medium
# DAILY_COST_CAP_USD=5
# MAX_COST_PER_RUN_USD=0.25
#
# Live store (see README). The app refuses to boot with DEMO_MODE and the live adapter together.
# SHOPIFY_ADAPTER=live
# SHOPIFY_SHOP_DOMAIN=your-dev-store.myshopify.com
# SHOPIFY_CLIENT_ID=            # A Dev Dashboard app's credentials. The 24-hour token then renews itself.
# SHOPIFY_CLIENT_SECRET=
# SHOPIFY_ACCESS_TOKEN=         # Or one token set by hand, never both. Nothing renews it.
# SHOPIFY_WEBHOOK_SECRET=       # For a Dev Dashboard app, the client secret.
# WRITEBACK_ENABLED=0
#
# Public demo (docs/DEPLOY_DEMO.md). Refuses to boot with a model key or store credentials.
# PUBLIC_DEMO=0
# TRUSTED_PROXY_HOPS=           # Required with PUBLIC_DEMO: proxies in front that append X-Forwarded-For.
# DEMO_RESET_MINUTES=0          # 0 never, otherwise at least 5. A public demo needs at least 5.
# APP_DB_PASSWORD=              # Required with PUBLIC_DEMO: the API and worker connect as the app role.
# RATE_LIMIT_PER_MINUTE=20      # Changes per client. RATE_LIMIT_GLOBAL_PER_MINUTE=300 for everyone together.
# READ_LIMIT_PER_MINUTE=300     # Reads per client. READ_LIMIT_GLOBAL_PER_MINUTE=1200 for everyone together.
# MAX_REQUEST_BYTES=65536       # Every mode. Outside a public demo the webhook route keeps its own 5 MiB cap.
#
# Reviewer sign-in: comma-separated name:role:sha256hex. Role is reviewer or admin.
# Tokens must be long and random, because a bare SHA-256 does not protect a guessable password. Generate one:
#   python -c "import hashlib,secrets;t=secrets.token_urlsafe(32);print(t, hashlib.sha256(t.encode()).hexdigest())"
# REVIEWER_TOKENS=alice:admin:<sha256hex>
